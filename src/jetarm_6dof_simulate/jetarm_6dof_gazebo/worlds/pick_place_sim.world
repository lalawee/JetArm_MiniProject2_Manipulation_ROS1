<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">

    <!-- Lighting -->
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose frame="">0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Physics -->
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>1</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Workspace table surface (flat white slab) -->
    <model name="workspace_table">
      <static>1</static>
      <!-- Thin slab centred under the arm's reachable workspace -->
      <pose frame="">0.15 0.0 -0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.50 0.50 0.010</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.50 0.50 0.010</size></box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         AprilTag Cube — Tag ID 1
         This is the object pick_place.py will pick up.
         Its pose is read by sim_tag_publisher.py from /gazebo/model_states.

         INITIAL POSITION: 22 cm forward from arm base, centred.
         Drag it with Gazebo's translate tool (press T) to test
         different pick positions, then re-run pick_place.py.

         The cube is 5 cm × 5 cm × 5 cm (same as real block).
         Centre z = 0.025 so the bottom face sits on z=0.
         ============================================================ -->
    <model name="apriltag_cube">
      <pose frame="">0.22 0.0 0.025 0 0 0</pose>
      <static>0</static>
      <link name="link">
        <inertial>
          <mass>0.02</mass>
          <inertia>
            <ixx>2.67e-6</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.67e-6</iyy><iyz>0</iyz>
            <izz>2.67e-6</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.03 0.03 0.05</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>3.0</mu><mu2>3.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <!-- Body: dark grey -->
        <visual name="body">
          <geometry>
            <box><size>0.03 0.03 0.048</size></box>
          </geometry>
          <pose frame="">0 0 -0.001 0 0 0</pose>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <!-- Top face: bright orange -->
        <visual name="top_face">
          <geometry>
            <box><size>0.03 0.03 0.002</size></box>
          </geometry>
          <pose frame="">0 0 0.024 0 0 0</pose>
          <material>
            <ambient>1.0 0.5 0.0 1</ambient>
            <diffuse>1.0 0.5 0.0 1</diffuse>
          </material>
        </visual>
        <!-- White label strip -->
        <visual name="tag_border">
          <geometry>
            <box><size>0.024 0.024 0.001</size></box>
          </geometry>
          <pose frame="">0 0 0.0255 0 0 0</pose>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
        <!-- Black inner square -->
        <visual name="tag_center">
          <geometry>
            <box><size>0.012 0.012 0.001</size></box>
          </geometry>
          <pose frame="">0 0 0.026 0 0 0</pose>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         AprilTag Cube 2 — Tag ID 2
         Offset 10 cm to the left of Cube 1.
         ============================================================ -->
    <model name="apriltag_cube_2">
      <pose frame="">0.20 0.10 0.025 0 0 0</pose>
      <static>0</static>
      <link name="link">
        <inertial>
          <mass>0.02</mass>
          <inertia>
            <ixx>2.67e-6</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.67e-6</iyy><iyz>0</iyz>
            <izz>2.67e-6</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.03 0.03 0.05</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>3.0</mu><mu2>3.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <!-- Body: dark grey -->
        <visual name="body">
          <geometry>
            <box><size>0.03 0.03 0.048</size></box>
          </geometry>
          <pose frame="">0 0 -0.001 0 0 0</pose>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <!-- Top face: blue -->
        <visual name="top_face">
          <geometry>
            <box><size>0.03 0.03 0.002</size></box>
          </geometry>
          <pose frame="">0 0 0.024 0 0 0</pose>
          <material>
            <ambient>0.0 0.3 1.0 1</ambient>
            <diffuse>0.0 0.3 1.0 1</diffuse>
          </material>
        </visual>
        <!-- White label strip -->
        <visual name="tag_border">
          <geometry>
            <box><size>0.024 0.024 0.001</size></box>
          </geometry>
          <pose frame="">0 0 0.0255 0 0 0</pose>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
        <!-- Black inner square -->
        <visual name="tag_center">
          <geometry>
            <box><size>0.012 0.012 0.001</size></box>
          </geometry>
          <pose frame="">0 0 0.026 0 0 0</pose>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Place goal marker — shows WHERE the arm will place the object.
         Matches PLACE_GOAL = [0.15, -0.10, 0.02] in pick_place.py.
         Static — does not move. -->
    <model name="place_goal_marker">
      <static>1</static>
      <pose frame="">0.215 -0.148 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.03</radius><length>0.002</length></cylinder>
          </geometry>
          <material>
            <ambient>0.0 0.8 0.0 0.6</ambient>
            <diffuse>0.0 0.8 0.0 0.6</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
